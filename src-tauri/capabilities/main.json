{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Capability for the primary window of ARK ASA Config Manager. Grants Tauri core/plugin permissions AND all 105 `allow-*` permissions auto-generated by `tauri_build::AppManifest::commands(...)` in `src-tauri/build.rs`. The list of `allow-*` permissions is the live source of truth produced by the build script; if `build.rs` ever adds/renames a command, re-run `cargo build` to regenerate `src-tauri/permissions/autogenerated/*.toml` and update the list below to match. `stronghold:default` is in place per IMPLEMENTATION_PLAN.md §P2 (secret_store_v2 migration). `updater:default` will be added in P6 when `tauri-plugin-updater` is wired in.",
  "windows": ["main"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "core:path:default",
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "core:resources:default",
    "core:menu:default",
    "core:tray:default",
    "core:window:allow-set-title",
    "store:default",
    "shell:allow-spawn",
    "shell:allow-execute",
    "stronghold:default",
    "allow-admin-token",
    "allow-backup-config",
    "allow-backup-saves",
    "allow-begin-convex-link",
