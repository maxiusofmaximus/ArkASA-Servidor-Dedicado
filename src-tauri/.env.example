# ─────────────────────────────────────────────────────────────────────────────
# ARK ASA Server Manager — environment variables for integrations (v2.2)
# ─────────────────────────────────────────────────────────────────────────────
# Every line is OPTIONAL. The desktop application boots even when the whole
# file is empty — each integration only comes online when its env vars say so.
#
# Copy this file to `.env` (and adjust values). The Tauri app reads env vars
# at startup; you can also export them inline before launching the binary.
# ─────────────────────────────────────────────────────────────────────────────

# ── Chat channels ─────────────────────────────────────────────────────────────
# Each chat channel is independent. Operators can enable one, several, or
# none. Commands (`/start`, `/stop`, `/status`, `/logs`, `/ip`, `/restart`,
# `/ai …` for natural language) are routed through the same internal
# `bridge::dispatch()`. Slash commands + AI natural-language replies are
# both available on every channel that supports them.

# ── Telegram Bot (long polling) ──────────────────────────────────────────────
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=                       # from @BotFather
TELEGRAM_ADMINS=                          # comma-separated chat_ids
ARK_ASA_CONFIG_PATH=server-config.toml

# ── Discord Bot (WebSocket gateway) ──────────────────────────────────────────
DISCORD_ENABLED=true
DISCORD_BOT_TOKEN=                        # from discord.com/developers/applications
DISCORD_ADMINS=                           # comma-separated user IDs
DISCORD_CHANNEL=                          # text channel the bot reads
DISCORD_AI_ENABLED=true

# ── Slack app (Socket Mode, no public URL needed) ─────────────────────────────
SLACK_ENABLED=true
SLACK_BOT_TOKEN=xoxb-...                  # Bot User OAuth Token
SLACK_APP_TOKEN=xapp-...                  # App-Level Token (connections:write)
SLACK_ADMINS=                             # comma-separated user U…IDs
SLACK_AI_ENABLED=true

# ── AI Assistant (OpenAI-compatible) ──────────────────────────────────────────
# Reused by every chat channel. Both natural-language input and structured
# `[COMMAND: {...}]` tags in model replies are recognised.
AI_ENABLED=true
AI_API_URL=https://api.openai.com/v1       # or cerebras.ai / integrate.api.nvidia.com / local vLLM / Ollama
AI_API_KEY=
AI_MODEL=gpt-4o-mini                       # gpt-4o-mini | llama3-8b-8192 | qwen2.5-coder | mistral-7b …

# ── Database backend (audit log) ──────────────────────────────────────────────
# Pick any one. SQLite is the no-network default.
DB_BACKEND=sqlite                          # sqlite | convex | supabase | insforge | postgres | mongodb
DB_URL=ark-config.db                       # file path or remote URL
DB_API_KEY=                                # anon / deploy / API key (not needed for SQLite)
DB_SCHEMA=public
DB_TABLE=command_log

# ── Multi-cloud hosting ───────────────────────────────────────────────────────
# The desktop app's "Hosting" tab calls `render_hosting_script` from these
# env vars to produce a cloud-init / user-data payload for the chosen VPS.
# See docs/HOSTING.md for the full provider list and the exact output format.
HOST_PROVIDER=hetzner                      # oracle | hetzner | digitalocean | selfhosted | aws | azure | gcp
HOST_REGION=fsn1
HOST_SSH_USER=arkasa
HOST_SSH_HOST=
HOST_SSH_PORT=22
HOST_SSH_KEY=~/.ssh/id_ed25519

# ── Legacy / v2.1 ─────────────────────────────────────────────────────────────
CONVEX_URL=
CONVEX_SHARED_SECRET=
