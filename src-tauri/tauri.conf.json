{
  "productName": "ARK ASA Config Manager",
  "version": "2.1.0",
  "identifier": "com.arkasa.configmanager",
  "build": {
    "beforeDevCommand": "pnpm --dir ./frontend dev",
    "beforeBuildCommand": "pnpm --dir ./frontend build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "ARK ASA Configuration Manager",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "label": "main"
      }
    ],
    "security": {
      "capabilities": ["main-capability"],
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost https://*.convex.cloud",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'unsafe-inline' 'self'",
        "script-src": "'self' 'wasm-unsafe-eval'"
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "wix": null,
      "allowDowngrades": false
    },
    "macOS": {
      "signingIdentity": null,
      "entitlements": null,
      "minimumSystemVersion": null,
      "exceptionDomain": ""
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "rpm": {}
    }
  }
}
