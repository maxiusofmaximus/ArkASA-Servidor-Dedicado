{
  "productName": "ARK ASA Config Manager",
  "version": "2.0.0",
  "identifier": "com.arkasa.configmanager",
  "build": {
    "beforeDevCommand": "pnpm --dir ./frontend dev",
    "beforeBuildCommand": "pnpm --dir ./frontend build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "ARK ASA Configuration Manager",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "windows": {
      "wix": null,
      "allowDowngrades": false
    },
    "macOS": {
      "signingIdentity": null,
      "entitlements": null,
      "minimumSystemVersion": null,
      "exceptionDomain": ""
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "rpm": {}
    }
  }
}
