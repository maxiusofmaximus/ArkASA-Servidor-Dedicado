{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "title": "ARK ASA Server",
  "uid": "arkasa-server",
  "tags": ["ark", "asa", "arkasa"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource scraping http://127.0.0.1:8765/api/v1/metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Server",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "arkasa_server_running", "legendFormat": "{{session}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "STOPPED", "color": "red" }, "1": { "text": "RUNNING", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Memory",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [ { "expr": "arkasa_process_memory_mb", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "decmbytes" }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Server FPS",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [ { "expr": "arkasa_server_fps", "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "Active mods",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [ { "expr": "arkasa_mods_active", "refId": "A" } ]
    },
    {
      "type": "timeseries",
      "title": "Memory (MB)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [ { "expr": "arkasa_process_memory_mb", "legendFormat": "{{session}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "decmbytes", "custom": { "drawStyle": "line", "fillOpacity": 12 } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Server FPS",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [ { "expr": "arkasa_server_fps", "legendFormat": "{{session}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 12 } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Public UDP connections",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [ { "expr": "arkasa_udp_conns", "legendFormat": "{{session}}", "refId": "A" } ]
    },
    {
      "type": "table",
      "title": "Config / ports",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "arkasa_max_players", "legendFormat": "max players", "refId": "A", "instant": true },
        { "expr": "arkasa_maps_total", "legendFormat": "maps", "refId": "B", "instant": true },
        { "expr": "arkasa_game_port", "legendFormat": "game port", "refId": "C", "instant": true },
        { "expr": "arkasa_query_port", "legendFormat": "query port", "refId": "D", "instant": true },
        { "expr": "arkasa_rcon_port", "legendFormat": "rcon port", "refId": "E", "instant": true }
      ],
      "transformations": [
        { "id": "reduce", "options": { "reducers": ["lastNotNull"] } },
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "Field": "Metric", "Last *": "Value" } } }
      ]
    }
  ]
}
