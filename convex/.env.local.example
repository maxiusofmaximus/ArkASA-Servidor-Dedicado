# Convex BaaS — environment variables
# This file is read by `npx convex dev` and `npx convex deploy`.
# DO NOT commit this file.  Run `cp .env.local.example .env.local` and edit.

# ── Auto-set by `npx convex dev` on first run ─────────────────────────────
# CONVEX_DEPLOY_KEY=  # deployment key (commented after first `convex dev`)

# ── Operator-set secrets (replace placeholders before `npx convex dev`) ───

# URL of the Convex project deployment (Settings → URL).
# Visible in https://dashboard.convex.dev/d/maxlive/ark-asa-admin
CONVEX_DEPLOYMENT=adjective-animal-123

# Shared HMAC secret.  Generate with: openssl rand -hex 64
# This must match INTEGRATIONS_SHARED_SECRET env var on your Convex dashboard.
INTEGRATIONS_SHARED_SECRET=PUT_YOUR_64_CHAR_HEX_SECRET_HERE

# ── Plugin secrets (only used when toggling on channels via TOML) ────────
# The desktop app picks these up via the `[plugins.<channel>]` TOML block
# below, plus env-vars here forward them to Convex actions when needed.

# Optional: forwarded to Tauri so Convex can call back the local API.
# Get this by running the desktop app once and copying the value from
# Options → General → Remote Admin.
TAURI_ADMIN_TOKEN=

# ── OAuth provider secrets (configure on Convex dashboard) ─────────────
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
