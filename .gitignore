# ========== RUST ARTIFACTS ==========
# Note: Cargo.lock IS tracked for this binary app. See Cargo FAQ:
# https://doc.rust-lang.org/cargo/faq.html#why-do-binaries-have-cargolock-in-version-control
target/
*.rlib
*.rmeta
*.pdb

# ========== NODE / NPM ==========
node_modules/
npm-debug.log
yarn-error.log
.pnp
dist/
build/
.swc/

# ========== VERCEL ==========
.vercel/

# ========== CONVEX ==========
convex/_generated/
.convex/
convex/.env
convex/.env.local

# ========== IDE / EDITOR ==========
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# ========== ENVIRONMENT ==========
.env
.env.local
.env.*.local
config-personal/

# ========== TAURI SPECIFIC ==========
src-tauri/target/
frontend/dist/
src-tauri/tauri.conf.json.bak

# ========== OS FILES ==========
Thumbs.db
Desktop.ini

# ========== LOGS & TEMP FILES ==========
*.log
*.tmp
tmp-*.ini
logs/
debug-logs/

# ========== BACKUPS & CONFIG ==========
*.backup
*.backup_*
config/
!src-tauri/src/config/
steamcmd/
server/
backups/

# ========== TEST COVERAGE & PLAYWRIGHT ==========
coverage/
.nyc_output/
.playwright/
.playwright-mcp/
playwright-report/
# Note: playwright.config.ts IS tracked. Do not ignore it.
frontend/screenshots/
frontend/real-screenshots/
frontend/examples/
frontend/test-results/

# ========== TAURI GENERATED ==========
# Note: src-tauri/gen/schemas/ IS tracked so capability JSONs can reference
# the desktop-schema.json at $schema:"../gen/schemas/desktop-schema.json"
# (the file is generated by tauri-build but versioning it avoids CI surprises).
# `permissions/autogenerated/` is regenerated by tauri-build on every cargo
# check and is intentionally NOT tracked — keeping it causes huge noisy diffs
# every time a command is added or a comment tweaked.
src-tauri/permissions/

# ========== BUILD ARTIFACTS & INSTALLERS ==========
*.exe
*.msi
*.dmg
*.app/

# ========== OTHER ==========
.cache/
.temp/
*.pem
*.key
chat.json
_tmp_*

# Session artifacts (do not commit)
session-*.md
.worktree/
src-tauri/target-next/

# Local SQLite scratch database (operator.debug / smoke tests only)
ark-config.db
src-tauri/ark-config.db

# Rolling TODO scratchpad kept at the workspace root (session-local)
TODO.md

# Local supervisor script (Windows-only; session-local)
supervisor.ps1

# BAK-suffixed planning / review docs (session-local backups)
docs/*_BAK.md
docs/*_BAK_*.md

# opencode session-local ignore file
.opencodeignore

# ========== GRAPHIFY ==========
# graphify-out/ is meant to be committed so the team shares the map;
# only the local-only build cache + cost log should be excluded.
graphify-out/cost.json
graphify-out/cache/
graphify-out/.graphify_root.tmp
graphify-out/.graphify_python
